		"landing.example.place.remember1": "Rikkihehkutin yksin ei pysäyttänyt härmää pohjoisessa kasvihuoneessa.",
		"landing.example.place.answer1": "Merkitty.",
		"landing.example.place.user2": "Hyvä. Mikä lopulta toimi?",
		"landing.example.place.search1": "härmä · kasvihuone · pohjoinen",
		"landing.example.place.answer2": "Kolme asiaa yhdessä, tässä järjestyksessä:\n1. ilmankiertoa tukkineiden sitruspistokkaiden poistaminen\n2. Nilsin maaliskuussa lainaama kanavapuhallin, joka pyöri vain öisin\n3. kastelu aamulla illan sijaan",
		"landing.example.project.title": "Projekti",
		"landing.example.project.user1": "Miksi luovuimme alkuperäisestä synkronointiprotokollasta?",
