# Dependencies (installed inside the image from the lockfile)
node_modules

# Build output (regenerated by `pnpm build` in the image)
build
.svelte-kit

# Secrets and runtime data never belong in the image.
.env*
data

# VCS and editor config
.git
.github
.vscode

# Docs and the build recipe itself are not needed to build.
*.md
Containerfile
.dockerignore
