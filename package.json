		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.85.1",
		"@earendil-works/pi-ai": "^0.85.1",
		"drizzle-orm": "1.0.0-rc.4",
